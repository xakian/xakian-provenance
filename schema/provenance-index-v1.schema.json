{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xakian/xakian-provenance/blob/main/schema/provenance-index-v1.schema.json",
  "title": "XAKIAN provenance index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updatedAt", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "projectId", "version", "publishedOn", "record", "sha256"],
        "properties": {
          "recordId": { "type": "string", "minLength": 1 },
          "projectId": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "publishedOn": { "type": "string", "format": "date" },
          "record": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
